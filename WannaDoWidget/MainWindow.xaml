<Window x:Class="WannaDoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WannaDoWidget"
        mc:Ignorable="d"
        Title="Wanna Do Widget" 
        Width="380"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Binding Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:DateFormatConverter x:Key="DateFormatConverter" />
        <local:StateToColorConverter x:Key="StateToColorConverter" />
        <local:StateTextConverter x:Key="StateTextConverter" />

        <!-- Custom ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#3300F0FF" Margin="0" MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background" Value="#9900F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ContextMenu Style (Cyber theme) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2081226" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F0FF" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.4"/>
                            </Border.Effect>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3300F0FF"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Card Style with Neon Blue Cyber Theme -->
        <Style x:Key="CyberCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="MinHeight" Value="115"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00F0FF" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ListBox Style without ScrollViewer for zero clipping -->
        <Style x:Key="NoClipListBoxStyle" TargetType="ListBox">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <local:NoClipItemsPresenter ClipToBounds="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:NoClipStackPanel ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" Margin="16,24,16,16" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Tabs (Row 1) -->
            <RowDefinition Height="*" />    <!-- Content Lists (Row 2) -->
            <RowDefinition Height="Auto" /> <!-- Input Form (Row 3, Bottom) -->
        </Grid.RowDefinitions>

        <!-- Slide Transform for top-down bounce entry -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTransform" Y="-1080" />
        </Grid.RenderTransform>

        <!-- 1. Header Area -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌸 Wanna Do" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#00F0FF"/>
                <TextBlock Text=" HUD" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#0078FF" 
                           VerticalAlignment="Bottom" 
                           Margin="2,0,0,3"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Click="CloseButton_Click" 
                    Background="Transparent" 
                    BorderBrush="Transparent"
                    Width="32" 
                    Height="32" 
                    Cursor="Hand"
                    ToolTip="Hide (Ctrl+Alt+S)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="16">
                            <TextBlock Text="✕" Foreground="#0078FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2200F0FF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Custom Tab Selectors -->
        <Grid x:Name="TabButtonsGrid" Grid.Row="1" Margin="0,0,0,12" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-50"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Styled Tab Buttons with Cyber accents -->
            <Button x:Name="TabTodoBtn" Grid.Column="0" Content="To Do" Click="TabBtn_Click" Tag="Todo" IsEnabled="False" Margin="0,0,4,0"/>
            <Button x:Name="TabDoneBtn" Grid.Column="1" Content="Done" Click="TabBtn_Click" Tag="Completed" Margin="2,0,2,0"/>
            <Button x:Name="TabOverBtn" Grid.Column="2" Content="Over" Click="TabBtn_Click" Tag="Over" Margin="4,0,0,0"/>
        </Grid>

        <!-- 3. Lists Container -->
        <local:NoClipGrid Grid.Row="2" ClipToBounds="False">
            <!-- 4a. TODO List -->
            <local:NoClipListBox x:Name="TodoListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Cyber styled card. Override Padding to 0 so the Grid clips at card boundaries -->
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD05122E" 
                                BorderBrush="#00F0FF"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show action menu">
                            <Grid ClipToBounds="True">
                                <!-- Main Card Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Memo -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>
                                    
                                    <!-- Metadata Footer Row -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Created Time -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[SYS_INIT " FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                        </StackPanel>
                                        
                                        <!-- Limit Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding DueDate, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="[LIMIT " FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DateFormatConverter}}" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="120"
                                        Background="#E505122E" 
                                        BorderBrush="#00F0FF"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Complete Button -->
                                        <Button Grid.Column="0" Click="CompleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Complete">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="Transparent">
                                                        <TextBlock Text="✓" Foreground="#00FF66" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#2200FF66"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Abort Button -->
                                        <Button Grid.Column="1" Click="AbortButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Abort">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                        <TextBlock Text="✕" Foreground="#FF0055" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#22FF0055"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>

            <!-- 4b. COMPLETED List -->
            <local:NoClipListBox x:Name="CompletedListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD031C10" 
                                BorderBrush="#00FF66"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show actions">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Main Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="#85B29B" 
                                               TextDecorations="Strikethrough" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>

                                    <!-- Metadata Footer -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Created Time -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[SYS_INIT " FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="[MISSION_ACCOMPLISHED]" FontSize="10" Foreground="#00FF66" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer (Delete only, Width=60) -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="60"
                                        Background="#E5031C10" 
                                        BorderBrush="#00FF66"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Delete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                    <TextBlock Text="🗑" Foreground="#FF5555" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#22FF5555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>

            <!-- 4c. ARCHIVED / EXPIRED List -->
            <local:NoClipListBox x:Name="OverListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD1C0808" 
                                BorderBrush="#FF0055"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show actions">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF0055" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Main Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="#C5A5A5" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>
                                    
                                    <!-- Metadata Footer -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Created Time -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[SYS_INIT " FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#5588FF" FontWeight="Bold"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="[STATUS: " FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateTextConverter}}" FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer (Delete only, Width=60) -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="60"
                                        Background="#E51C0808" 
                                        BorderBrush="#FF0055"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Delete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                    <TextBlock Text="🗑" Foreground="#FF5555" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#22FF5555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>
        </local:NoClipGrid>

        <!-- 4. Quick Input Area (Pill shaped, messaging app style) -->
        <Border x:Name="InputAreaBorder" Grid.Row="3" 
                Opacity="0"
                Background="#BD050C1E" 
                BorderBrush="#0078FF" 
                BorderThickness="1.5" 
                CornerRadius="22" 
                Height="44"
                Padding="8,2,8,2"
                Margin="0,16,0,0">
            <Border.RenderTransform>
                <TranslateTransform Y="50"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />    <!-- Text Input (Left) -->
                    <ColumnDefinition Width="Auto" /> <!-- DatePicker Button (Middle) -->
                    <ColumnDefinition Width="Auto" /> <!-- Send Button (Right) -->
                </Grid.ColumnDefinitions>

                <!-- Left: Text Box -->
                <TextBox x:Name="MemoTextBox" 
                         Grid.Column="0"
                         FontSize="14"
                         Foreground="White"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="#00F0FF"
                         SelectionBrush="#0078FF"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="4,0"
                         AcceptsReturn="True"
                         PreviewKeyDown="MemoTextBox_PreviewKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                                <TextBlock x:Name="textBlockPlaceholder" Text="Add a new Wanna Do item..." Foreground="#4400F0FF" Margin="4,0" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="textBlockPlaceholder" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Middle: Compact Date Picker Button with Cyber styling -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
                    <DatePicker x:Name="DueDatePicker"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                SelectedDateChanged="DueDatePicker_SelectedDateChanged">
                        <DatePicker.Resources>
                            <!-- Hide default textbox -->
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                            <!-- Override Dropdown button to fit cyber theme -->
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="4" BorderBrush="#0078FF" BorderThickness="1" Width="28" Height="28">
                                                <TextBlock x:Name="iconText" Text="📅" Foreground="#0078FF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2200F0FF"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                                                    <Setter TargetName="iconText" Property="Foreground" Value="#00F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <!-- Small indicator dot showing that a date is selected -->
                    <Border x:Name="DateActiveBadge"
                            Background="#00F0FF"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Margin="0,2,2,0"/>
                </Grid>

                <!-- Right: Pill send button -->
                <Button Grid.Column="2" 
                        Click="AddButton_Click" 
                        Width="32" 
                        Height="32" 
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="4,0,2,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="Transparent" 
                                    CornerRadius="16" 
                                    BorderBrush="#00F0FF" 
                                    BorderThickness="1.5">
                                <TextBlock Text="＞" 
                                           Foreground="#00F0FF" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#00F0FF"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
