<Window x:Class="WannaDoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WannaDoWidget"
        mc:Ignorable="d"
        Title="Wanna Do Widget" 
        Width="380"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Binding Converters -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:DateFormatConverter x:Key="DateFormatConverter" />
        <local:StateToColorConverter x:Key="StateToColorConverter" />
        <local:StateTextConverter x:Key="StateTextConverter" />

        <Style x:Key="CyberCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="#FF081A33"/>
            <Setter Property="Foreground" Value="#F2FCFF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CalendarItemStyle" Value="{DynamicResource CyberCalendarItemStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{DynamicResource CyberCalendarButtonStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource CyberCalendarDayButtonStyle}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EAFBFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EAFBFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7895B8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

                <Style x:Key="CyberCalendarNavButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="#9EEFFF"/>
                    <Setter Property="Background" Value="#142E50"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="NavSurface"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavSurface" Property="Background" Value="#28547C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CyberCalendarItemStyle" TargetType="CalendarItem">
                    <Setter Property="Foreground" Value="#F4FCFF"/>
                    <Setter Property="Background" Value="#FF081A33"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CalendarItem">
                                <ControlTemplate.Resources>
                                    <DataTemplate x:Key="DayTitleTemplate">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#9FC6DC"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ControlTemplate.Resources>
                                <Border Background="{TemplateBinding Background}" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <Grid x:Name="PART_Root">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#FF102A50" CornerRadius="4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="PART_PreviousButton"
                                                        Grid.Column="0"
                                                        Content="&#x276E;"
                                                        Style="{StaticResource CyberCalendarNavButtonStyle}"/>
                                                <CalendarButton x:Name="PART_HeaderButton"
                                                                Grid.Column="1"
                                                                Style="{x:Null}"
                                                                Foreground="#EAFBFF"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                FontSize="16"
                                                                FontWeight="Bold"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Focusable="False">
                                                    <CalendarButton.Template>
                                                        <ControlTemplate TargetType="CalendarButton">
                                                            <Border x:Name="HeaderSurface"
                                                                    Background="Transparent"
                                                                    CornerRadius="4">
                                                                <TextBlock Text="{TemplateBinding Content}"
                                                                           Foreground="#EAFBFF"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="HeaderSurface" Property="Background" Value="#28547C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CalendarButton.Template>
                                                </CalendarButton>
                                                <Button x:Name="PART_NextButton"
                                                        Grid.Column="2"
                                                        Content="&#x276F;"
                                                        Style="{StaticResource CyberCalendarNavButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                        <Grid x:Name="PART_MonthView" Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#B9D7EA"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>

                <Style x:Key="CyberCalendarDayButtonStyle" TargetType="CalendarDayButton">
                    <Setter Property="Foreground" Value="#EAFBFF"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CalendarDayButton">
                                <Border x:Name="DaySurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                    <TextBlock x:Name="DayText"
                                               Text="{TemplateBinding Content}"
                                               Foreground="#EAFBFF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DaySurface" Property="Background" Value="#5500D8FF"/>
                                        <Setter TargetName="DaySurface" Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter TargetName="DaySurface" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="DayText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsToday" Value="True">
                                        <Setter TargetName="DaySurface" Property="BorderBrush" Value="#FF0055"/>
                                        <Setter TargetName="DaySurface" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="DayText" Property="Foreground" Value="#FF9FBC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="DaySurface" Property="Background" Value="#FF00A8D8"/>
                                        <Setter TargetName="DaySurface" Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter TargetName="DaySurface" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="DayText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsInactive" Value="True">
                                        <Setter TargetName="DayText" Property="Foreground" Value="#7895B8"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsBlackedOut" Value="True">
                                        <Setter TargetName="DayText" Property="Foreground" Value="#4E6685"/>
                                        <Setter Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CyberCalendarButtonStyle" TargetType="CalendarButton">
                    <Setter Property="Foreground" Value="#F4FCFF"/>
                    <Setter Property="Background" Value="#1800A8D8"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CalendarButton">
                                <Border x:Name="MonthSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#334E77"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="MonthText"
                                               Text="{TemplateBinding Content}"
                                               Foreground="#EAFBFF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="MonthSurface" Property="Background" Value="#5500D8FF"/>
                                        <Setter TargetName="MonthSurface" Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter TargetName="MonthText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsInactive" Value="True">
                                        <Setter TargetName="MonthText" Property="Foreground" Value="#7895B8"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Custom ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="true"
                                   IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#3300F0FF" Margin="0" MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background" Value="#9900F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ContextMenu Style (Cyber theme) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2081226" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F0FF" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.4"/>
                            </Border.Effect>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3300F0FF"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Card Style with Neon Blue Cyber Theme -->
        <Style x:Key="CyberCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="MinHeight" Value="115"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00F0FF" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#8096B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#334E77"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TabSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveLine"
                                    Height="2"
                                    Margin="12,0"
                                    VerticalAlignment="Bottom"
                                    Background="#00F0FF"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#1600F0FF"/>
                                <Setter Property="Foreground" Value="#C8F9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#2600F0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Background" Value="#280078A8"/>
                                <Setter TargetName="ActiveLine" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style without ScrollViewer for zero clipping -->
        <Style x:Key="NoClipListBoxStyle" TargetType="ListBox">
            <Setter Property="ClipToBounds" Value="False"/>
            <EventSetter Event="PreviewMouseWheel" Handler="ListBox_PreviewMouseWheel"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <local:ToggleClipGrid x:Name="ScrollViewport"
                                              ClipToBounds="True">
                            <local:NoClipItemsPresenter x:Name="ListItemsPresenter"
                                                        ClipToBounds="False" />
                            <ScrollBar x:Name="ListScrollBar"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       SmallChange="60"
                                       LargeChange="180"
                                       Visibility="Collapsed"
                                       ValueChanged="ListScrollBar_ValueChanged" />

                            <Border x:Name="TopScrollIndicator"
                                    Height="36"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5500F0FF" Offset="0"/>
                                        <GradientStop Color="#0000F0FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border x:Name="BottomScrollIndicator"
                                    Height="36"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0000F0FF" Offset="0"/>
                                        <GradientStop Color="#5500F0FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </local:ToggleClipGrid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:NoClipStackPanel ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" Margin="16,24,16,16" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Tabs (Row 1) -->
            <RowDefinition Height="*" />    <!-- Content Lists (Row 2) -->
            <RowDefinition Height="Auto" /> <!-- Input Form (Row 3, Bottom) -->
        </Grid.RowDefinitions>

        <!-- Slide Transform for top-down bounce entry -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTransform" Y="-1080" />
        </Grid.RenderTransform>

        <!-- 1. Header Area -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌸 Wanna Do" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#00F0FF"/>
                <TextBlock Text=" HUD" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#0078FF" 
                           VerticalAlignment="Bottom" 
                           Margin="2,0,0,3"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Click="CloseButton_Click" 
                    Background="Transparent" 
                    BorderBrush="Transparent"
                    Width="32" 
                    Height="32" 
                    Cursor="Hand"
                    ToolTip="Hide (Ctrl+Alt+S)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="16">
                            <TextBlock Text="✕" Foreground="#0078FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2200F0FF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Custom Tab Selectors -->
        <Grid x:Name="TabButtonsGrid" Grid.Row="1" Margin="0,0,0,12" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="-50"/>
            </Grid.RenderTransform>

            <Border Background="#B5050C1E"
                    BorderBrush="#334E77"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TabTodoBtn"
                            Grid.Column="0"
                            Style="{StaticResource HudTabButtonStyle}"
                            Click="TabBtn_Click"
                            Tag="Todo"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#00F0FF" Margin="0,0,7,0"/>
                            <TextBlock Text="ACTIVE" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="TodoCountText" Text="0" Foreground="#00F0FF" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" Background="#334E77" Margin="0,8"/>

                    <Button x:Name="TabDoneBtn"
                            Grid.Column="2"
                            Style="{StaticResource HudTabButtonStyle}"
                            Click="TabBtn_Click"
                            Tag="Completed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#00FF66" Margin="0,0,7,0"/>
                            <TextBlock Text="DONE" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="DoneCountText" Text="0" Foreground="#00FF66" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3" Background="#334E77" Margin="0,8"/>

                    <Button x:Name="TabOverBtn"
                            Grid.Column="4"
                            Style="{StaticResource HudTabButtonStyle}"
                            Click="TabBtn_Click"
                            Tag="Over">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FF0055" Margin="0,0,7,0"/>
                            <TextBlock Text="OVER" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="OverCountText" Text="0" Foreground="#FF557F" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Lists Container -->
        <local:NoClipGrid Grid.Row="2" ClipToBounds="False">
            <!-- 4a. TODO List -->
            <local:NoClipListBox x:Name="TodoListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Cyber styled card. Override Padding to 0 so the Grid clips at card boundaries -->
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD05122E" 
                                BorderBrush="#00F0FF"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show action menu">
                            <Grid ClipToBounds="True">
                                <!-- Main Card Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Memo -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>
                                    
                                    <!-- Metadata Footer Row -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"
                                                   FontSize="10"
                                                   Foreground="#5588FF"
                                                   FontWeight="Bold"/>

                                        <!-- Limit Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding DueDate, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="[LIMIT " FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DateFormatConverter}}" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#00F0FF" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="120"
                                        Background="#E505122E" 
                                        BorderBrush="#00F0FF"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Complete Button -->
                                        <Button Grid.Column="0" Click="CompleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Complete">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="Transparent">
                                                        <TextBlock Text="✓" Foreground="#00FF66" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#2200FF66"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Abort Button -->
                                        <Button Grid.Column="1" Click="AbortButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Abort">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                        <TextBlock Text="✕" Foreground="#FF0055" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#22FF0055"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>

            <!-- 4b. COMPLETED List -->
            <local:NoClipListBox x:Name="CompletedListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD031C10" 
                                BorderBrush="#00FF66"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show actions">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Main Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="#85B29B" 
                                               TextDecorations="Strikethrough" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>

                                    <!-- Metadata Footer -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"
                                                   FontSize="10"
                                                   Foreground="#5588FF"
                                                   FontWeight="Bold"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="[MISSION_ACCOMPLISHED]" FontSize="10" Foreground="#00FF66" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer (Delete only, Width=60) -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="60"
                                        Background="#E5031C10" 
                                        BorderBrush="#00FF66"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Delete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                    <TextBlock Text="🗑" Foreground="#FF5555" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#22FF5555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>

            <!-- 4c. ARCHIVED / EXPIRED List -->
            <local:NoClipListBox x:Name="OverListView"
                      Style="{StaticResource NoClipListBoxStyle}"
                      Background="Transparent" 
                      BorderThickness="0" 
                      Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Style="{StaticResource CyberCardStyle}" 
                                Padding="0"
                                Background="#BD1C0808" 
                                BorderBrush="#FF0055"
                                PreviewMouseLeftButtonDown="Card_Click"
                                Cursor="Hand"
                                ToolTip="Click to show actions">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF0055" Direction="270" ShadowDepth="1" BlurRadius="12" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Main Content (Margin = Card Padding) -->
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Memo}" 
                                               TextWrapping="Wrap" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="#C5A5A5" 
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>
                                    
                                    <!-- Metadata Footer -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"
                                                   FontSize="10"
                                                   Foreground="#5588FF"
                                                   FontWeight="Bold"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="[STATUS: " FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateTextConverter}}" FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                            <TextBlock Text="]" FontSize="10" Foreground="#FF0055" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Slide-in Action Drawer (Delete only, Width=60) -->
                                <Border x:Name="ActionPanel" 
                                        HorizontalAlignment="Right" 
                                        Width="0" 
                                        Tag="60"
                                        Background="#E51C0808" 
                                        BorderBrush="#FF0055"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="0,8,8,0"
                                        Opacity="0">
                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click" Tag="{Binding Id}" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" ToolTip="Delete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,8,8,0">
                                                    <TextBlock Text="🗑" Foreground="#FF5555" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#22FF5555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </local:NoClipListBox>
        </local:NoClipGrid>

        <!-- 4. Quick Input Area (Pill shaped, messaging app style) -->
        <Border x:Name="InputAreaBorder" Grid.Row="3" 
                Opacity="0"
                Background="#BD050C1E" 
                BorderBrush="#0078FF" 
                BorderThickness="1.5" 
                CornerRadius="22" 
                Height="44"
                Padding="8,2,8,2"
                Margin="0,16,0,0">
            <Border.RenderTransform>
                <TranslateTransform Y="50"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />    <!-- Text Input (Left) -->
                    <ColumnDefinition Width="Auto" /> <!-- DatePicker Button (Middle) -->
                    <ColumnDefinition Width="Auto" /> <!-- Send Button (Right) -->
                </Grid.ColumnDefinitions>

                <!-- Left: Text Box -->
                <TextBox x:Name="MemoTextBox" 
                         Grid.Column="0"
                         FontSize="14"
                         Foreground="White"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="#00F0FF"
                         SelectionBrush="#0078FF"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="4,0"
                         AcceptsReturn="True"
                         PreviewKeyDown="MemoTextBox_PreviewKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                                <TextBlock x:Name="textBlockPlaceholder" Text="Add a new Wanna Do item..." Foreground="#4400F0FF" Margin="4,0" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="textBlockPlaceholder" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Middle: Compact Date Picker Button with Cyber styling -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
                    <DatePicker x:Name="DueDatePicker"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                CalendarStyle="{StaticResource CyberCalendarStyle}"
                                SelectedDateChanged="DueDatePicker_SelectedDateChanged">
                        <DatePicker.Resources>
                            <!-- Hide default textbox -->
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <!-- Opaque overlay hides the theme-provided emoji while clicks pass through. -->
                    <Border Background="#FF050C1E"
                            BorderBrush="#0078FF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Width="28"
                            Height="28"
                            IsHitTestVisible="False">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="16" Height="16">
                                <Path Stroke="#00B8E8"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 2.5,4.5 L 13.5,4.5 L 13.5,13.5 L 2.5,13.5 Z M 2.5,7 L 13.5,7 M 5,2.5 L 5,5.5 M 11,2.5 L 11,5.5 M 5,9.5 L 6.5,9.5 M 9.5,9.5 L 11,9.5 M 5,11.5 L 6.5,11.5 M 9.5,11.5 L 11,11.5"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- Small indicator dot showing that a date is selected -->
                    <Border x:Name="DateActiveBadge"
                            Background="#00F0FF"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Margin="0,2,2,0"/>
                </Grid>

                <!-- Right: Pill send button -->
                <Button Grid.Column="2" 
                        Click="AddButton_Click" 
                        Width="32" 
                        Height="32" 
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="4,0,2,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="Transparent" 
                                    CornerRadius="16" 
                                    BorderBrush="#00F0FF" 
                                    BorderThickness="1.5">
                                <TextBlock Text="＞" 
                                           Foreground="#00F0FF" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#00F0FF"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
